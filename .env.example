# Postgres connection string used by the api container (and by Alembic).
# In docker-compose this points at the `db` service; for local (non-docker) dev
# against a native Windows Postgres install, use `localhost` instead of `db`.
DATABASE_URL=postgresql+psycopg://helix:helix@db:5432/helix

# Google Gemini API key. Leave empty to run Helix with AI features disabled:
# the app still boots, seeds, and is fully browsable — only AI actions return
# a clean AI_UNAVAILABLE error instead of crashing. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Verify these against the current google-genai SDK/docs before relying on
# them long-term — model IDs change. Defaults below were current as of build time.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# Must match the `vector(EMBEDDING_DIM)` column width in the migration.
# Gemini's embedding model is asked to truncate to this dimensionality via
# output_dimensionality. Changing this requires a new migration.
EMBEDDING_DIM=768

# HS256 signing secret for JWTs. Change this for anything beyond local dev.
JWT_SECRET=change-me
JWT_EXPIRY_MINUTES=480

# How many rows of the HuggingFace help-desk-tickets sample the seeder loads.
SEED_TICKET_LIMIT=300

# Hybrid retrieval tuning.
RETRIEVAL_TOP_K=5
GROUNDING_MIN_SCORE=0.020

# Deterministic correlation tuning (services/correlation.py).
DUPLICATE_THRESHOLD=0.88
STORM_WINDOW_MINUTES=30
STORM_MIN_INCIDENTS=4
